MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=americonfort
# Must be ≥32 characters in production (server refuses to start otherwise)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
# Customer completion/signature links use the FIRST origin. Prefer www (SPA), not the apex (WordPress).
CLIENT_URL=https://www.americonfort.com,https://americonfort.com
# Canonical public site used by sitemap locs + signature URL fallback (defaults to https://www.americonfort.com)
PUBLIC_SITE_URL=https://www.americonfort.com
PORT=3000
# NODE_ENV=production
# TRUST_PROXY=true

# ImageKit (required for car/profile image uploads; customer ID docs use private files)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Signed access TTL for customer documents / local uploads (seconds). Default 15 minutes.
# DOC_SIGNED_URL_TTL_SECONDS=900

# Optional agency admin seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# Platform Super Admin (dedicated /superadmin login — never share with agency admins)
# Seed with: npm run seed:superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password
SUPERADMIN_NAME=Super Admin

# Trial / license (single agency — not multi-tenant)
# New admins get a trial of TRIAL_DAYS. Manage via Super Admin panel or:
# npm run license:status|activate|extend|trial|expire
TRIAL_DAYS=7

# WhatsApp — wa.me only (no Meta/Twilio API). Fallback when Admin Settings numbers are empty:
WHATSAPP_BUSINESS_NUMBER=212600000000
WHATSAPP_CURRENCY=MAD

# Agency branding (emails / PDFs)
AGENCY_NAME=Americonfort
CURRENCY=MAD
API_PUBLIC_URL=https://api.americonfort.com
COMPLETION_TOKEN_DAYS=7
DEPOSIT_PERCENT=30

# Google Business Profile reviews (homepage Reviews section)
# Enable Places API (legacy Place Details) on a server-restricted API key.
# Find Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=ChIJ...
# Optional cache TTL in ms (default 6 hours)
# GOOGLE_REVIEWS_CACHE_MS=21600000

# Email (SMTP) — REQUIRED for completion & final confirmation emails
# Gmail: enable 2FA → create App Password → paste WITHOUT needing spaces
# SMTP_FROM should use the same address as SMTP_USER (Gmail rejects mismatched From)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=Americonfort <your-smtp-user@example.com>
# SMTP_DEBUG=true
# SMTP_ALLOW_CUSTOM_FROM=false

# Online payments — Stripe required in production (demo is blocked unless ALLOW_DEMO_PAYMENT=true)
PAYMENT_MODE=demo
PAYMENT_CURRENCY=mad
STRIPE_SECRET_KEY=
# ALLOW_DEMO_PAYMENT=true
# Break-glass: allow owner to force ready_for_pickup without completion (default off)
# ALLOW_FORCE_BOOKING_STATUS=true

# Puppeteer / Chrome (PDF contracts & invoices)
# On Render, Chrome must live in the project tree (see server/.puppeteerrc.cjs).
# Build must run: npm run install:chrome  (also hooked via postinstall / render.yaml)
# Optional: override binary if using system Chrome instead of Puppeteer Chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
