# API origin only — do NOT append /api (client paths already include /api/...).
# In dev you can leave this unset: Vite proxies /api → http://localhost:3000
VITE_BASE_URL=http://localhost:3000
VITE_CURRENCY=MAD
# Fallback only — prefer Admin → Settings → WhatsApp numbers (stored in DB)
VITE_WHATSAPP_BUSINESS_NUMBER=212600000000
# Optional public social profiles (leave empty to hide icons)
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXX). Leave empty to disable.
# Must be set in Vercel Production env so Vite injects gtag into the built index.html.
VITE_GA4_MEASUREMENT_ID=G-ZLJ4Z0MFM0
# Google Search Console HTML tag content value (meta name="google-site-verification")
VITE_GSC_VERIFICATION=
